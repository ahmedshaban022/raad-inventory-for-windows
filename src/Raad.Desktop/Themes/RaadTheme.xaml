<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ============================================================
       Raad Inventory — desktop theme
       Palette: Raad green over warm green-neutral surfaces.
       Typography: Cairo, embedded from Assets/Cairo.ttf.
       ============================================================ -->

  <!-- Typography -->
  <FontFamily x:Key="Raad.Font.Cairo">/Raad.Inventory.Feasibility;component/Assets/#Cairo</FontFamily>
  <sys:Double xmlns:sys="clr-namespace:System;assembly=System.Runtime" x:Key="Raad.Font.Body">14</sys:Double>

  <!-- Brand -->
  <Color x:Key="Raad.Color.BrandDeep">#14452F</Color>
  <Color x:Key="Raad.Color.BrandPrimary">#1E6F45</Color>
  <SolidColorBrush x:Key="Raad.Brand.Deep" Color="{StaticResource Raad.Color.BrandDeep}"/>
  <SolidColorBrush x:Key="Raad.Brand.Primary" Color="{StaticResource Raad.Color.BrandPrimary}"/>
  <SolidColorBrush x:Key="Raad.Brand.Hover" Color="#175B39"/>
  <SolidColorBrush x:Key="Raad.Brand.Pressed" Color="#114730"/>

  <!-- Surfaces -->
  <SolidColorBrush x:Key="Raad.Surface.App" Color="#F2F4EF"/>
  <SolidColorBrush x:Key="Raad.Surface.Card" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Raad.Surface.Subtle" Color="#F7F9F4"/>
  <SolidColorBrush x:Key="Raad.Surface.Field" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="Raad.Surface.Hover" Color="#F1F5F0"/>
  <SolidColorBrush x:Key="Raad.Surface.Pressed" Color="#E6ECE4"/>
  <SolidColorBrush x:Key="Raad.Surface.Selected" Color="#E4EFE7"/>
  <SolidColorBrush x:Key="Raad.Surface.Disabled" Color="#F4F6F2"/>

  <!-- Borders -->
  <SolidColorBrush x:Key="Raad.Border.Subtle" Color="#E1E6DE"/>
  <SolidColorBrush x:Key="Raad.Border.Field" Color="#849388"/>
  <SolidColorBrush x:Key="Raad.Border.Strong" Color="#AEBBAC"/>

  <!-- Text -->
  <SolidColorBrush x:Key="Raad.Text.Primary" Color="#16211B"/>
  <SolidColorBrush x:Key="Raad.Text.Secondary" Color="#47564C"/>
  <SolidColorBrush x:Key="Raad.Text.Muted" Color="#5E6C61"/>
  <SolidColorBrush x:Key="Raad.Text.Disabled" Color="#78857B"/>
  <SolidColorBrush x:Key="Raad.Text.OnBrand" Color="#FFFFFF"/>

  <!-- ================= Cards ================= -->
  <Style x:Key="Raad.Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Raad.Surface.Card}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Raad.Border.Subtle}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="10"/>
  </Style>

  <!-- ================= Text ================= -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Raad.Font.Cairo}"/>
    <Setter Property="FontSize" Value="{StaticResource Raad.Font.Body}"/>
    <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>

  <Style TargetType="Label">
    <Setter Property="FontFamily" Value="{StaticResource Raad.Font.Cairo}"/>
    <Setter Property="FontSize" Value="{StaticResource Raad.Font.Body}"/>
    <Setter Property="Foreground" Value="{StaticResource Raad.Text.Secondary}"/>
    <Setter Property="Padding" Value="0,0,0,4"/>
  </Style>

  <!-- ================= Buttons ================= -->
  <Style x:Key="Raad.Button.Base" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Raad.Font.Cairo}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Foreground" Value="{StaticResource Raad.Text.Primary}"/>
    <Setter Property="Background" Value="{StaticResource Raad.Surface.Card}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Raad.Border.Field}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Raad.Surface.Hover}"/>
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Raad.Border.Strong}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Raad.Surface.Pressed}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Raad.Brand.Primary}"/>
              <Setter TargetName="Root" Property="BorderThickness" Value="1.6"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Raad.Surface.Disabled}"/>
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Raad.Border.Subtle}"/>
              <Setter Property="Foreground" Value="{StaticResource Raad.Text.Disabled}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Raad.Button.Secondary" TargetType="Button" BasedOn="{StaticResource Raad.Button.Base}"/>

  <Style x:Key="Raad.Button.Primary" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Raad.Font.Cairo}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Raad.Text.OnBrand}"/>
    <Setter Property="Background" Value="{StaticResource Raad.Brand.Primary}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Raad.Brand.Primary}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"
                  SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Raad.Brand.Hover}"/>
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Raad.Brand.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Raad.Brand.Pressed}"/>
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Raad.Brand.Pressed}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Raad.Text.OnBrand}"/>
              <Setter TargetName="Root" Property="BorderThickness" Value="1.6"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Raad.Surface.Disabled}"/>
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Raad.Border.Subtle}"/>
              <Setter Property="Foreground" Value="{StaticResource Raad.Text.Disabled}"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= Text field ================= -->
  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Raad.Font.Cairo}"/>
    <Setter Property="FontSize" Value="{StaticResource Raad.Font.Body}"/>
    <Setter Property="Foreground" Value="{StaticResource Raad.Text.Primary}"/>
    <Setter Property="Background" Value="{StaticResource Raad.Surface.Field}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Raad.Border.Field}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,7"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="CaretBrush" Value="{StaticResource Raad.Brand.Primary}"/>
    <Setter Property="SelectionBrush" Value="{StaticResource Raad.Brand.Primary}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                          Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Raad.Brand.Primary}"/>
              <Setter TargetName="Root" Property="BorderThickness" Value="1.6"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Background" Value="{StaticResource Raad.Surface.Disabled}"/>
              <Setter Property="Foreground" Value="{StaticResource Raad.Text.Disabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= Combo box ================= -->
  <Style x:Key="Raad.ComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource Raad.Font.Cairo}"/>
    <Setter Property="FontSize" Value="{StaticResource Raad.Font.Body}"/>
    <Setter Property="FlowDirection" Value="RightToLeft"/>
    <Setter Property="Foreground" Value="{StaticResource Raad.Text.Primary}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
              <Border x:Name="ItemRoot" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                  BorderThickness="1" BorderBrush="Transparent"
                  CornerRadius="6" Margin="4,1" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource Raad.Surface.Hover}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="ItemRoot" Property="Background" Value="{StaticResource Raad.Surface.Selected}"/>
              <Setter Property="Foreground" Value="{StaticResource Raad.Brand.Deep}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{StaticResource Raad.Brand.Primary}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="ItemRoot" Property="Background" Value="Transparent"/>
              <Setter Property="Foreground" Value="{StaticResource Raad.Text.Disabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource Raad.Font.Cairo}"/>
    <Setter Property="FontSize" Value="{StaticResource Raad.Font.Body}"/>
    <Setter Property="Foreground" Value="{StaticResource Raad.Text.Primary}"/>
    <Setter Property="Background" Value="{StaticResource Raad.Surface.Field}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Raad.Border.Field}"/>
    <Setter Property="MinHeight" Value="36"/>
    <Setter Property="Padding" Value="10,0,6,0"/>
    <Setter Property="FlowDirection" Value="RightToLeft"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource Raad.ComboBoxItem}"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="8" MinHeight="{TemplateBinding MinHeight}" SnapsToDevicePixels="True">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="ContentSite" Grid.Column="0" Margin="{TemplateBinding Padding}"
                                  VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False"
                                  Content="{TemplateBinding SelectionBoxItem}"
                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                <Path x:Name="Chevron" Grid.Column="1" Width="11" Height="6" Margin="0,0,12,0" VerticalAlignment="Center"
                      Data="M 0.5 0.5 L 5.5 5 L 10.5 0.5" Stroke="{StaticResource Raad.Text.Secondary}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
              </Grid>
            </Border>
            <ToggleButton x:Name="ToggleButton" Background="Transparent" BorderThickness="0" Focusable="False"
                          ClickMode="Press" IsTabStop="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border Background="Transparent"/>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom" PopupAnimation="None" Focusable="False"
                   IsOpen="{TemplateBinding IsDropDownOpen}" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                   MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
              <Border Background="{StaticResource Raad.Surface.Card}" BorderBrush="{StaticResource Raad.Border.Strong}"
                      BorderThickness="1" CornerRadius="10" Padding="3" Margin="0,4,0,0"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                      FlowDirection="RightToLeft">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="260">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Raad.Border.Strong}"/>
            </Trigger>
            <Trigger Property="IsDropDownOpen" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Raad.Brand.Primary}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Raad.Brand.Primary}"/>
              <Setter TargetName="Field" Property="BorderThickness" Value="1.6"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Field" Property="Background" Value="{StaticResource Raad.Surface.Disabled}"/>
              <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource Raad.Border.Subtle}"/>
              <Setter Property="Foreground" Value="{StaticResource Raad.Text.Disabled}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ================= Data grid ================= -->
  <Style TargetType="DataGrid">
    <Setter Property="FontFamily" Value="{StaticResource Raad.Font.Cairo}"/>
    <Setter Property="FontSize" Value="{StaticResource Raad.Font.Body}"/>
    <Setter Property="Foreground" Value="{StaticResource Raad.Text.Primary}"/>
    <Setter Property="Background" Value="{StaticResource Raad.Surface.Card}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="RowBackground" Value="{StaticResource Raad.Surface.Card}"/>
    <Setter Property="AlternatingRowBackground" Value="{StaticResource Raad.Surface.Card}"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Raad.Border.Subtle}"/>
    <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
    <Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="SelectionMode" Value="Single"/>
  </Style>

  <Style TargetType="DataGridColumnHeader">
    <Setter Property="FontFamily" Value="{StaticResource Raad.Font.Cairo}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource Raad.Text.Secondary}"/>
    <Setter Property="Background" Value="{StaticResource Raad.Surface.Subtle}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Raad.Border.Subtle}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="10,8"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style x:Key="Raad.Header.Numeric" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
    <Setter Property="HorizontalContentAlignment" Value="Right"/>
  </Style>

  <Style x:Key="Raad.Cell.Base" TargetType="DataGridCell">
    <Setter Property="FontFamily" Value="{StaticResource Raad.Font.Cairo}"/>
    <Setter Property="Foreground" Value="{StaticResource Raad.Text.Primary}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="HorizontalContentAlignment" Value="Right"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>

  <Style TargetType="DataGridCell" BasedOn="{StaticResource Raad.Cell.Base}"/>

  <!-- Numeric cells stay left-to-right so real values read correctly inside an RTL grid. -->
  <Style x:Key="Raad.Cell.Latin" TargetType="DataGridCell" BasedOn="{StaticResource Raad.Cell.Base}">
    <Setter Property="FlowDirection" Value="LeftToRight"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
  </Style>
</ResourceDictionary>
